---
import Pannel from "./bg/Pannel.astro";

interface Props {
  title: string;
  tagline: string;
  content: string;
  wrapped?: boolean;
}

const { title, tagline, content, wrapped } = Astro.props;
---

<div class="text-white flex gap-2 flex-col">
  <Pannel>
    <h1 class="lg:text-3xl text-2xl">{title}</h1>
    <h1 class="lg:text-xl text-xl">{tagline}</h1>
    <p class="pt-1 text-sm">{content}</p>
  </Pannel>
</div>
