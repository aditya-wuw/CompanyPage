---
import Image from "astro/components/Image.astro";
import { siteContent } from "../../../data/lang/content_en";
import smug from "../../../../public/logo/NyaTeam_BG.webp";

const name = "SMUG CAT'S";
---

<div class="text-white p-3  px-10 overflow-y-auto h-[90%]">
  <Image
    src={smug}
    width={185}
    alt={"smug"}
    class="rounded-2xl float-right md:m-8 m-3 md:w-46 w-20"
  />
  <h1 class="mt-5 font-medium md:text-3xl text-xl mb-5">{name}</h1>
  {siteContent.en.abouts.split("\n").map((i) => <p class="mt-3 md:text-lg text-sm">{i}</p>)}
</div>
