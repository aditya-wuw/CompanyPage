---
import Pannel from "../../bg/Pannel.astro";
---

<div
  class="mt-5 md:mx-5 mx-3 h-50 p-3 rounded flex md:justify-between max-md:flex-col-reverse"
>
  <div class="mx-15 relative">
    <div
      class="absolute z-3 w-120 h-50 text-white overflow-hidden drop-shadow-2xl drop-shadow-black rounded-md"
    >
      <img src="gal.jpg" alt="" class="object-cover" />
    </div>
    <div
      class="absolute z-2 hover:left-100 left-8 w-120 h-50 text-white overflow-hidden drop-shadow-2xl drop-shadow-black rounded-md"
    >
      <img src="mkway.jpg" alt="" class="object-cover" />
    </div>
    <div
      class="absolute z-1 hover:left-100 left-15 w-120 h-50 text-white overflow-hidden drop-shadow-2xl drop-shadow-black rounded-md"
    >
      <img src="mkway.jpg" alt="" class="object-cover" />
    </div>
  </div>
  <div
    class="lg:text-6xl text-3xl text-white mt-10 md:mx-12 flex flex-col justify-end lg:items-end"
  >
    <h1>Yo ho!</h1>
    <p>Check What's New</p>
  </div>
</div>
