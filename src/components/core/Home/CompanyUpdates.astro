---
import TPButton from "../../Buttons/TPButton.astro";
import SmallCard from "../../SmallCard.astro";
import { LuRotate3D } from "react-icons/lu";

interface Props {
  LatestAsset: LatestAsset;
}

interface LatestAsset {
  banner: string;
  name: string;
}

const { LatestAsset } = Astro.props;
---

<div class="mt-5 flex justify-center">
  <div class="flex max-md:flex-col-reverse gap-3 w-[90%] relative">
    <div>
      { LatestAsset && <SmallCard
        image={`${import.meta.env.PUBLIC_ASSETS}/${LatestAsset.banner}`}
        alt="info"
      />}
    </div>
    <div
      class="xl:text-5xl md:text-3xl text-2xl text-white flex flex-col items-end justify-end w-full lg:pb-5"
    >
      <h1>Yo ho!</h1>
      <p class="flex md:gap-5 gap-2 items-center">
        Check What's New <LuRotate3D />
      </p>
    </div>
  </div>
</div>
