---
import TPButton from "./Buttons/TPButton.astro";

interface Props {
  image: string;
  alt: string;
  title?: string;
}

const { image, alt, title } = Astro.props;
---

<div
  class="relative lg:w-120 lg:h-50 sm:w-90 h-40 w-75 text-white overflow-hidden drop-shadow-2xl drop-shadow-black/20 rounded-md"
>
  <h1 class="text-2xl">{title}</h1>
  <div class="absolute z-1 bottom-4 right-2">
    <TPButton label="Check latest" link="Assets" />
  </div>
  <img
    src={image}
    alt={alt}
    class="object-cover inset-0 absolute -z-1 w-full h-full"
  />
</div>
