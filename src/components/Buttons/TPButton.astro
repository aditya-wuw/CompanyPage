---
interface Props {
  label: string;
  link: string;
}

const { label, link } = Astro.props;
---

<a
  transition:name={`btn-${link.trim()}`}
  class="md:text-md text-sm bg-gray-300/20 hover:bg-gray-300/40 transition duration-200 ease-in-out backdrop-blur-xs border border-gray-400/10 rounded-md p-2 text-gray-300 isolation-auto"
  href={`/${link} `}
>
  {label}
</a>
