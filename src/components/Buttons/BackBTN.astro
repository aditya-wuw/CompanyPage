---
import { IoChevronBack } from "react-icons/io5";
---

<button
  onclick="history.back()"
  class="cursor-pointer bg-gray-300/10 hover:bg-gray-300/20 transition duration-200 ease-in-out backdrop-blur-xs border border-gray-400/10 rounded-md p-2 text-white isolation-auto"
>
  <div class="flex justify-center items-center gap-2 md:text-md text-xs">
    <IoChevronBack />
    <h1 class="pt-0.5">Go Back</h1>
  </div>
</button>
