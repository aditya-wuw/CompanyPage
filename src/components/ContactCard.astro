---
import { MdEmail } from "react-icons/md";
import { siteContent } from "../data/lang/content_en";
import { BsYoutube } from "react-icons/bs";
---

<div class="text-4xl flex items-center gap-5">
  <div class="bg-white w-fit p-2 rounded-2xl hover:scale-125 hover:rotate-6 duration-300 ease-in-out">
    <a href={siteContent.en.contact.itech} target="_blank">
      <img
        src="https://static.itch.io/images/logo-black-new.svg"
        width={100}
        alt="itech"
      />
    </a>
  </div>
  <div class="text-white hover:scale-125 hover:-rotate-20 duration-300 ease-in-out">
    <a href={siteContent.en.contact.yt}> <BsYoutube /></a>
  </div>
  <div class="text-white hover:scale-125 hover:rotate-20 duration-300 ease-in-out">
    <a href={`mailto:${siteContent.en.contact.email}`}><MdEmail /></a>
  </div>
</div>
