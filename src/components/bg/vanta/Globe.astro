<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"
></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.globe.min.js"
></script>
<script>
  var instance_3d: any = null;
  declare var VANTA: any;

  function initVanta() {
    if (instance_3d) {
      instance_3d.destroy();
      instance_3d = null;
    }
    instance_3d = VANTA.GLOBE({
      el: "#ani-bg",
      mouseControls: true,
      touchControls: true,
      gyroControls: false,
      minHeight: 200.0,
      minWidth: 200.0,
      scale: 1.0,
      scaleMobile: 1.0,
      color: 0xafa2de,
      size: 0.5,
      backgroundColor:  0x1f1525,
    });
  }

  document.addEventListener("astro:page-load", initVanta);
</script>
