---
import Assets from "./Assets.astro";
interface Props {
  products: GameAssetPack[];
}
interface GameAssetPack {
  id: string;
  name: string;
  preview: string;
  banner: string;
  itech_store: string;
  fab_store: string;
  unity_store: string;
  description: string;
  more_description: string;
  category: string[];
  is3D: boolean;
  tags: string[];
  anims: string[];
}
const { products } = Astro.props;
---

<div>
  <Assets products={products} />
</div>
