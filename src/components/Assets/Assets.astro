---
import AssetsBanner from "./AssetsBanner.astro";

interface Props {
  products: GameAssetPack[];
}
interface GameAssetPack {
  id: string;
  name: string;
  preview: string;
  banner: string;
  itech_store: string;
  fab_store: string;
  unity_store: string;
  description: string;
  more_description: string;
  category: string[];
  is3D: boolean;
  tags: string[];
  anims: string[];
}
const { products } = Astro.props;
---

<div class="md:mx-10 mx-3 text-white">
  <span class="md:text-2xl text-xl"> List of available assets </span>
  <div class="flex flex-col mt-5">
    {
      products && products.length > 0 ? (
        products.map((i: GameAssetPack) => <AssetsBanner prod={i} />)
      ) : (
        <div>no assets listed</div>
      )
    }
  </div>
</div>
