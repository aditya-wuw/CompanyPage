---
import AssetsBanner from "./AssetsBanner.astro";

interface Props {
  products: GameAssetPack[];
}
interface GameAssetPack {
  id: string;
  name: string;
  preview: string;
  banner: string;
  itech_store: string;
  fab_store: string;
  unity_store: string;
  description: string;
  more_description: string;
  category: string[];
  is3D: boolean;
  tags: string[];
  anims: string[];
}
const { products } = Astro.props;
---

<div class="p-5">
  List of available products
  <div class="flex flex-col">
    {
      products && products.length > 0 ? (
        products.map((i: GameAssetPack) => <AssetsBanner prod={i} />)
      ) : (
        <div>no assets listed</div>
      )
    }
  </div>
</div>
