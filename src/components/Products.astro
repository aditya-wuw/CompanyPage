---
interface Product {
  name: string;
  id: string;
}

const products: Array<Product> = [
  { name: "Apple", id: "asdadasdasd312313" },
  { name: "PineApple", id: "dasdadax311313" },
];
---

<div class="bg-green-500 p-5">
  List of available products
  <div class="flex flex-col">
    {
      products.map((i) => (
        <a class="p-3 bg-red-500 mt-2 w-40" href={`/preview/${i.id}`}>
          {i.name}
        </a>
      ))
    }
  </div>
</div>
