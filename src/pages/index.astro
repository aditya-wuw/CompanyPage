---
export const prerender = false;
import ContactCard from "../components/ContactCard.astro";
import CompanyUpdates from "../components/core/Home/CompanyUpdates.astro";
import Hero from "../components/core/Home/Hero.astro";
import Para from "../components/Para.astro";
import { siteContent } from "../data/lang/content_en";
import ScrollDown from "../components/React/ScrollDown";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    class="mt-2 h-full isolate max-lg:overflow-y-auto"
    style="clip-path: inset(0 0 0 0);"
  >
    <!-- hero -->
    <div transition:animate="initial">
      <Hero />
    </div>
    <!-- latest updates -->
    <div class="lg:overflow-y-auto lg:h-80">
      <div class="lg:mt-20 mt-10">
        <CompanyUpdates />
      </div>
      <div class="flex justify-end px-15">
        <ScrollDown client:load />
      </div>
      <!-- Motto -->
      <div class="lg:mt-20 mt-15 flex justify-center">
        <div class="w-[90%] flex gap-5 max-md:flex-col" id="scroll-target">
          {
            siteContent.en.cards.map((i) => (
              <Para title={i.title} tagline={i.tagline} content={i.content} />
            ))
          }
        </div>
      </div>
      <div class="mt-10 mb-10 mx-15 flex justify-end">
        <ContactCard />
      </div>
    </div>
  </div>
</Layout>
