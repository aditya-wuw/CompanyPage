---
import { slide } from "astro:transitions";
import TPButton from "../../../components/Buttons/TPButton.astro";
import Layout from "../../../layouts/Layout.astro";

export const prerender = false;
const { id } = Astro.params;

if (!id) {
  Astro.redirect("/404");
}
---

<Layout>
  <main  transition:animate={slide({ duration: "0.8s" })}>
    <TPButton label="Go Back" link="products" />
    <div class="mt-5">
      <div class="bg-blue-400">Showing preview of : {id}</div>
    </div>
  </main>
</Layout>

