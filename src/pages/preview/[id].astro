---
import Layout from "../../layouts/Layout.astro";
import BackBTN from "../../components/Buttons/BackBTN.astro";
import PreviewToggle from "../../components/React/PreviewToggle";
export const prerender = false;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/error/404");
}
---

<Layout>
  <main class="mx-5">
    <BackBTN />
    <PreviewToggle id={id} client:load />
  </main>
</Layout>
