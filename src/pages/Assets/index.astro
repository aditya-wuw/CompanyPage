---
export const prerender = false;
import Assets from "../../components/Assets/Assets.astro";
import Layout from "../../layouts/Layout.astro";

let products = [];

try {
  const response = await fetch(`${import.meta.env.PUBLIC_ASSETS}/info`, {
    method: "GET",
  });
  if (!response.ok) {
    return Astro.redirect("/error/404");
  }
  products = await response.json();
} catch (error) {
  console.error("fetech error : ", error);
  return Astro.redirect("/error/500");
}
---

<Layout> <Assets products={products} /></Layout>
