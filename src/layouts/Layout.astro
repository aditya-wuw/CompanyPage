---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Box from "../components/bg/Box.astro";
import BGPatternBlur from "../components/bg/BGPatternBlur.astro";
import FingerPrint from "../components/FingerPrint.astro";

const pageDescription =
  "Smug Cat's Games, Game-ready assets optimized for Godot and more";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/logo/NyaTeam.png" />
    <meta name="description" content={pageDescription} />
    <title>Smug Cat's</title>
    <ClientRouter />
  </head>
  <body class="bg-black">
    <div class="bg-black/50 blur-3xl rounded-full w-full h-full absolute z-1">
    </div>
    <BGPatternBlur />
    <Box><slot /></Box>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
    <FingerPrint />
  </body>
</html>
