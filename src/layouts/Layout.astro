---
import Background from "../components/bg/Background.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Box from "../components/bg/Box.astro";
import BGPattern from "../components/bg/BGPattern.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Null Team's</title>
    <ClientRouter />
  </head>
  <body>
    <BGPattern />
    <Box><slot /></Box>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </body>
</html>
