---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Foot from "../components/Foot.astro";
const pageDescription = "Smug Cat's tools, assets and Jounry";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/logo/NyaTeam.png" />
    <meta name="description" content={pageDescription} />
    <title>Smug Cat's</title>
    <ClientRouter />
  </head>
  <body class="bg-black">
    <div
      class="bg-purple-950/13 blur-3xl rounded-full w-full h-full absolute z-1"
    >
    </div>
    <div class="max-w-6xl mx-auto">
      <slot />
    </div>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
      }
    </style>
    <Foot />
  </body>
</html>
